NODE_ENV=development
DB_CONECTION_DEV=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
# Access JWTs are deliberately short-lived. The opaque refresh token is only
# sent as a secure HttpOnly cookie and its hash is stored in MongoDB.
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=14d
REFRESH_TOKEN_PEPPER=replace-with-a-different-long-random-secret
# Vercel and Render are different sites, so the deployed POS needs None +
# Secure. For local HTTP development use lax and false instead.
REFRESH_COOKIE_SAME_SITE=none
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_NAME=pos_refresh
# Set only behind a known reverse proxy (Render normally uses 1). It makes
# req.ip suitable for rate limiting without trusting arbitrary client headers.
TRUST_PROXY_HOPS=1
LOGIN_RATE_LIMIT_PEPPER=replace-with-a-third-long-random-secret
SECRET_KEY_SESSION=replace-with-another-long-random-secret
# Additional exact origins. The public first-party POS is always authorized.
# No wildcard or blanket *.vercel.app access is supported.
CORS_ORIGINS=http://localhost:5173,https://point-of-sale-app-silk.vercel.app

# Optional migration-only connection. Apply requires MIGRATION_CONFIRM_DB to
# equal the target database name.
MIGRATION_DATABASE_URL=
MIGRATION_CONFIRM_DB=

PORT=3000
APP_ENV=development
# Set to deployed commit; never put secrets in APP_VERSION.
APP_VERSION=local
