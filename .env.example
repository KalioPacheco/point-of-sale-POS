NODE_ENV=development
DB_CONECTION_DEV=mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1h
SECRET_KEY_SESSION=replace-with-another-long-random-secret
CORS_ORIGINS=http://localhost:5173

# Optional migration-only connection. Apply requires MIGRATION_CONFIRM_DB to
# equal the target database name.
MIGRATION_DATABASE_URL=
MIGRATION_CONFIRM_DB=
